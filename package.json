    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "5.2.0",
    "typescript": "5.9.3",
    "vite": "7.3.7",
    "vitest": "5.0.4"
  },
  "engines": {
    "node": ">=22"
  }
}
